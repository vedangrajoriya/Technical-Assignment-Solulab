# ==============================================================================
# ForgeFlow Manufacturing ERP — Environment Configuration Template
# Copy this file to '.env' for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local Docker Desktop or Render Managed PostgreSQL internal connection URL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mfg_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mfg_erp
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Application & Security Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="ForgeFlow Manufacturing ERP"
VERSION="1.0.0"
ENVIRONMENT=development  # Use 'production' on Render to lock scenario resets

# JWT Secret Key (Generate random 256-bit string in production)
JWT_SECRET_KEY=forgeflow-super-secure-production-jwt-key-2026-mfg-erp
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (Comma-separated for multiple domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://forgeflow-frontend.onrender.com

# ------------------------------------------------------------------------------
# 3. Initial Administrative Profile (Seed Config)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@forgeflow.com
SEED_ADMIN_USERNAME=superadmin
SEED_ADMIN_PASSWORD=change_this_secure_password_in_production

# ------------------------------------------------------------------------------
# 4. Frontend Build-Time Variables (Vite)
# ------------------------------------------------------------------------------
# In production on Render, set to https://forgeflow-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
